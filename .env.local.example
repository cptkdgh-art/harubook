# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📘 하루책 (Harubook) — 환경변수 템플릿
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 이 파일을 .env.local 로 복사해서 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다.

# ──────────────────────────
# Firebase (로그인/백업용)
# ──────────────────────────
# console.firebase.google.com → 프로젝트 설정 → 일반 → 웹 앱 → firebaseConfig 에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=harubook-xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=harubook-xxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=harubook-xxxxx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc...
